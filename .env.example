# Clave que n8n debe enviar en la cabecera X-API-Key para usar la API de la tienda
API_KEY=cambia-esta-clave
# Webhook de n8n que recibe los eventos de la tienda (dejar vacío para desactivarlo)
N8N_WEBHOOK_URL=http://n8n:5678/webhook/tienda
# Clave privada de la cabecera X-PF-Webhook-Key; configurar también en n8n. Vacía impide enviar.
N8N_WEBHOOK_KEY=
# 1 = cargar datos de ejemplo la primera vez que arranca la app, 0 = arrancar vacía
SEED=1
