    },
    {
      "id": "67d2970b-86da-47ad-a33e-e3fdb401ed96",
      "name": "Fijar período",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "\nconst c=$input.first().json.config;\nif(!c.API_BASE_URL||!/^https?:\\/\\//.test(c.API_BASE_URL)||!c.CORREO_MARISA||!c.CORREO_REMITENTE)throw new Error('Falta configuración del informe');\nconst hoy=$now.setZone('Europe/Madrid');\nconst fecha=hoy.minus({days:1}).toISODate();return [{json:{config:c,desde:fecha,hasta:fecha,medido:hoy.toISO()}}];"
      }
    },
    {
      "id": "e4bde87f-a71d-4c3b-905e-a54ead72e4a1",
      "name": "Consultar ventas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        720,
        0
      ],
      "parameters": {
        "url": "={{ $(\"Fijar período\").first().json.config.API_BASE_URL + \"/api/ventas\" + \"?desde=\" + $(\"Fijar período\").first().json.desde + \"&hasta=\" + $(\"Fijar período\").first().json.hasta }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "PF · API tienda"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "56341c38-bafb-4bee-b384-59e02f0b4c61",
      "name": "Consultar abonos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        960,
        0
      ],
      "parameters": {
        "url": "={{ $(\"Fijar período\").first().json.config.API_BASE_URL + \"/api/abonos\" + \"?desde=\" + $(\"Fijar período\").first().json.desde + \"&hasta=\" + $(\"Fijar período\").first().json.hasta }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
