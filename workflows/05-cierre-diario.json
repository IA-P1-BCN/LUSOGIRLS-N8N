    {
      "id": "ac1eacf7-37c4-45e9-9ccd-32296b3374cb",
      "name": "Calcular cierre",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "\nconst cent=v=>{if(!/^(0|[1-9]\\d*)(\\.\\d{1,2})?$/.test(String(v)))throw new Error('Importe inválido');const [a,b='']=String(v).split('.');const n=Number(a)*100+Number(b.padEnd(2,'0'));if(!Number.isSafeInteger(n))throw new Error('Importe fuera de rango');return n;};\nconst add=(a,b)=>{const n=a+b;if(!Number.isSafeInteger(n))throw new Error('Total fuera de rango');return n;};\nconst euros=n=>(n/100).toFixed(2)+' EUR';\nconst date=v=>typeof v==='string'&&/^\\d{4}-\\d{2}-\\d{2}$/.test(v)&&!Number.isNaN(Date.parse(v))&&new Date(v).toISOString().slice(0,10)===v;\nconst medios=['efectivo','tarjeta','bizum','transferencia'];\nconst list=(r,requireCount=false)=>{if(r.statusCode!==200||!Array.isArray(r.body))throw new Error('Respuesta API incompleta');if(requireCount&&Number(r.headers?.['x-total-count'])!==r.body.length)throw new Error('Lista API incompleta');return r.body;};\nconst totals=(rows,desde,hasta)=>{const by={efectivo:0,tarjeta:0,bizum:0};const ids=new Set();let total=0;for(const r of rows){if(!Number.isSafeInteger(r.id)||r.id<1||ids.has(r.id)||!date(r.fecha)||r.fecha<desde||r.fecha>hasta||!medios.includes(r.forma_pago))throw new Error('Movimiento API inválido');ids.add(r.id);const n=cent(r.importe);if(n<=0)throw new Error('Movimiento sin importe positivo');by[r.forma_pago]=add(by[r.forma_pago]||0,n);total=add(total,n);}return {total,by};};\n\nconst p=$('Fijar período').first().json;\nconst ventas=list($('Consultar ventas').first().json,true),abonos=list($('Consultar abonos').first().json);\nconst v=totals(ventas,p.desde,p.hasta),a=totals(abonos,p.desde,p.hasta),total=add(v.total,a.total);\nconst por_forma_pago_centimos={};for(const medio of medios)if(medio!=='transferencia'||v.by[medio]||a.by[medio])por_forma_pago_centimos[medio]=add(v.by[medio]||0,a.by[medio]||0);\nconst filas=['Medio | Ventas directas | Abonos | Total',...Object.keys(por_forma_pago_centimos).map(m=>`${m} | ${euros(v.by[m]||0)} | ${euros(a.by[m]||0)} | ${euros(por_forma_pago_centimos[m])}`)];\nconst documento={fecha_cierre:p.desde,ventas_centimos:v.total,abonos_centimos:a.total,total_centimos:total,por_forma_pago_centimos,sin_movimientos:ventas.length+abonos.length===0,destinatario:p.config.CORREO_MARISA,remitente:p.config.CORREO_REMITENTE,asunto:`Paso Firme · Cierre ${p.desde}`,texto:`Cierre ${p.desde} (Europe/Madrid)\\n${filas.join('\\n')}\\nVentas directas: ${euros(v.total)}\\nAbonos: ${euros(a.total)}\\nTOTAL: ${euros(total)}${ventas.length+abonos.length===0?'\\nSin movimientos.':''}`};\nreturn [{json:{clave:`cierre:${p.desde}`,tipo:'cierre_diario',documento}}];\n"
      }
    },
    {
      "id": "9a094273-bfa4-45a4-887d-3d2c550b7a1e",
