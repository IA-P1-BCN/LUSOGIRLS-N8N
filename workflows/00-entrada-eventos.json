      "name": "Leer configuración",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        240,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(jsonb_object_agg(clave,valor),'{}'::jsonb) AS config, $1::jsonb AS entrada FROM pf_config",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json)] }}"
        }
      },
      "credentials": {
        "postgres": {
          "name": "PF · Registro auxiliar"
        }
      }
    },
    {
      "id": "3f131d86-c817-434f-8939-b253d0755e7e",
      "name": "Validar evento y destino",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "\nconst {entrada,config:c}=$input.first().json;\nconst body=entrada.body;\nif(!body||typeof body!=='object'||Array.isArray(body)||typeof body.evento!=='string'||!body.datos||typeof body.datos!=='object'||Array.isArray(body.datos))throw new Error('Evento incompleto');\nconst destinos={'apartado.creado':'PF01_WORKFLOW_ID','abono.registrado':'PF02_WORKFLOW_ID','venta.registrada':'PF04_WORKFLOW_ID','apartado.vencido':'PF06_WORKFLOW_ID'};\nif(!Object.hasOwn(destinos,body.evento))throw new Error('Evento desconocido');\nconst id=c[destinos[body.evento]];if(!id||!/^[a-zA-Z0-9_-]{1,80}$/.test(id))throw new Error('Falta configurar el subworkflow del evento');\nreturn [{json:{body,workflow_id:id}}];\n"
      }
    },
